  "description": "Command-line interface to programmatically interact with Code for IBM i via the VS Code Bridge.",
  "publishConfig": {
    "access": "public"
  },
  "author": "Rishabh Kaushik",
  "license": "MIT",
  "keywords": [
    "ibmi",
    "as400",
    "code-for-ibmi",
